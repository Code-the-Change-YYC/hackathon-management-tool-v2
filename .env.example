# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""
# Public application URL used by Better Auth for callbacks and redirects
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated browser origins allowed to call Better Auth
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Google OAuth credentials. Configure the redirect URI as
# ${BETTER_AUTH_URL}/api/auth/callback/google in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Drizzle
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
CONTENTFUL_SPACE_ID="your_space_id"
CONTENTFUL_ACCESS_TOKEN="your_access_token"
